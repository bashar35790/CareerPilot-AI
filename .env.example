# PostgreSQL Container Configuration
POSTGRES_USER=careerpilot_user
POSTGRES_PASSWORD=careerpilot_password
POSTGRES_DB=careerpilot_db
POSTGRES_PORT=5432

# Backend API Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://careerpilot_user:careerpilot_password@postgres:5432/careerpilot_db?schema=public

# Authentication Security Secrets
JWT_SECRET=super_secret_jwt_access_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration & CORS
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
